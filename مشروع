import asyncio
from core.crypto import SecureChannel
from core.protocol import HEADER_SIZE, MessageType, encode_header, decode_header

class EncryptedTransport:
    def __init__(self, reader: asyncio.StreamReader, writer: asyncio.StreamWriter, channel: SecureChannel):
        self.reader = reader
        self.writer = writer
        self.channel = channel
        self.seq = 1

    async def send_message(self, text: str):
        enc_payload = self.channel.encrypt(text.encode("utf-8"))
        header = encode_header(MessageType.TEXT, len(enc_payload), self.seq)
        self.seq += 1
        self.writer.write(header + enc_payload)
        await self.writer.drain()

    async def read_message(self) -> str:
        header_bytes = await self.reader.readexactly(HEADER_SIZE)
        msg_type, length, _ = decode_header(header_bytes)
        enc_payload = await self.reader.readexactly(length)
        decrypted = self.channel.decrypt(enc_payload)
        return decrypted.decode("utf-8")

