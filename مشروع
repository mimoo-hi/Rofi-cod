from stem.control import Controller

class TorManager:
    def __init__(self, control_port: int = 9051):
        self.control_port = control_port
        self.controller = None
        self.service_id = None

    def start_onion_service(self, local_port: int = 5000) -> str:
        try:
            self.controller = Controller.from_port(port=self.control_port)
            self.controller.authenticate()
            res = self.controller.create_ephemeral_hidden_service(
                {80: local_port}, key_type="NEW", key_content="ED25519-V3"
            )
            self.service_id = res.service_id
            return f"{self.service_id}.onion"
        except Exception:
            return None

    def stop(self):
        if self.controller and self.service_id:
            try:
                self.controller.remove_ephemeral_hidden_service(self.service_id)
            except Exception:
                pass
