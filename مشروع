import asyncio
import os
from core.identity import decode_id_final
from core.crypto import derive_session_key, SecureChannel
from client.transport import EncryptedTransport

class PeerSession:
    def __init__(self, shared_secret: bytes):
        self.shared_secret = shared_secret

    async def connect(self, peer_id: str) -> EncryptedTransport:
        ip, port = decode_id_final(peer_id, self.shared_secret)
        reader, writer = await asyncio.open_connection(ip, port)
        
        my_salt = os.urandom(16)
        writer.write(my_salt)
        await writer.drain()
        
        peer_salt = await reader.readexactly(16)
        session_key = derive_session_key(self.shared_secret, my_salt + peer_salt)
        channel = SecureChannel(session_key, my_nonce_prefix=b"\x01\x02\x03\x04")
        
        return EncryptedTransport(reader, writer, channel)

    async def listen(self, port: int, callback):
        async def handle(reader, writer):
            peer_salt = await reader.readexactly(16)
            my_salt = os.urandom(16)
            writer.write(my_salt)
            await writer.drain()
            
            session_key = derive_session_key(self.shared_secret, peer_salt + my_salt)
            channel = SecureChannel(session_key, my_nonce_prefix=b"\x05\x06\x07\x08")
            transport = EncryptedTransport(reader, writer, channel)
            await callback(transport)

        return await asyncio.start_server(handle, "0.0.0.0", port)

