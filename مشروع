import asyncio
import sys
from core.identity import get_local_ip, encode_id_final
from client.session import PeerSession

SHARED_SECRET = b"my_super_secret_shared_key_32b!!"
PORT = 5000

async def handle_incoming(transport):
    print("\n[+] تم اتصال صديقك بنجاح! تبادلا الرسائل الآن:")
    asyncio.create_task(receiver(transport))
    await sender(transport)

async def receiver(transport):
    try:
        while True:
            msg = await transport.read_message()
            print(f"\n[صديقك]: {msg}\n[أنت]: ", end="")
    except Exception:
        print("\n[-] انقطع الاتصال.")

async def sender(transport):
    loop = asyncio.get_event_loop()
    while True:
        msg = await loop.run_in_executor(None, input, "[أنت]: ")
        if msg.strip():
            await transport.send_message(msg)

async def main():
    print("=== P2P Secure Chat ===")
    role = input("اختر الدور (1 = خادم/Host, 2 = عميل/Connect): ").strip()
    session = PeerSession(SHARED_SECRET)

    if role == "1":
        ip = get_local_ip()
        my_id = encode_id_final(ip, PORT, SHARED_SECRET)
        print(f"\n[+] الـ ID الخاص بك للشبكة المحلية: {my_id}")
        print("[+] بانتظار اتصال صديقك...")
        
        server = await session.listen(PORT, handle_incoming)
        async with server:
            await server.serve_forever()

    elif role == "2":
        peer_id = input("أدخل الـ ID الخاص بصديقك: ").strip()
        print("[+] جاري الاتصال...")
        try:
            transport = await session.connect(peer_id)
            print("[+] تم الاتصال بنجاح!")
            asyncio.create_task(receiver(transport))
            await sender(transport)
        except Exception as e:
            print(f"[-] فشل الاتصال: {e}")

if __name__ == "__main__":
    try:
        asyncio.run(main())
    except KeyboardInterrupt:
        print("\nتم الإغلاق.")

