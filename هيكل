"""
identity.py — توليد ID مشفر من IP
====================================
الفكرة:
  IP + Port + Secret → AES-GCM → Base32 → ID (10 أحرف)

الـ ID قابل للفك فقط إذا عندك نفس الـ Secret.
"""

import hashlib
import hmac
import socket
import base64
from nacl.secret import SecretBox
from nacl.utils import random as nacl_random


# ═══════════════════════════════════════════════════════════
#  1. الحصول على IP العام
# ═══════════════════════════════════════════════════════════

def get_public_ip() -> str:
    """
    الحصول على IP العام.
    ملاحظة: هذا يستخدم خدمة خارجية مجانية فقط لمعرفة IP.
    يمكن استبدالها بـ STUN أو DNS query (لا تحتاج سيرفر).
    """
    import urllib.request
    
    services = [
        "https://api.ipify.org",
        "https://ifconfig.me/ip",
        "https://icanhazip.com",
    ]
    
    for url in services:
        try:
            with urllib.request.urlopen(url, timeout=5) as r:
                ip = r.read().decode().strip()
                # تحقق من صحة IP
                socket.inet_aton(ip)
                return ip
        except Exception:
            continue
    
    raise RuntimeError("فشل الحصول على IP العام")


def get_local_ip() -> str:
    """الحصول على IP المحلي (للـ LAN)"""
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        s.connect(("8.8.8.8", 80))
        return s.getsockname()[0]
    finally:
        s.close()


# ═══════════════════════════════════════════════════════════
#  2. اشتقاق مفتاح التشفير من Secret مشترك
# ═══════════════════════════════════════════════════════════

def derive_key(shared_secret: bytes) -> bytes:
    """
    اشتقاق مفتاح 32 بايت من السر المشترك.
    نستخدم HKDF-like بسيط.
    """
    if len(shared_secret) < 16:
        raise ValueError("السر المشترك يجب أن يكون 16 بايت على الأقل")
    
    # HKDF-Expand مبسط
    prk = hmac.new(b"p2p-id-salt-v1", shared_secret, hashlib.sha256).digest()
    okm = hmac.new(prk, b"p2p-id-info-v1", hashlib.sha256).digest()
    return okm  # 32 بايت


# ═══════════════════════════════════════════════════════════
#  3. تحويل IP → ID
# ═══════════════════════════════════════════════════════════

# أبجدية مخصصة: أحرف صغيرة + أرقام (بدون أحرف متشابهة)
ALPHABET = "abcdefghjkmnpqrstuvwxyz23456789"  # 31 حرف (بدون i,l,o,0,1)

def _base32_custom(data: bytes, length: int) -> str:
    """تحويل bytes إلى سلسلة بالأبجدية المخصصة"""
    result = []
    for byte in data[:length]:
        result.append(ALPHABET[byte % len(ALPHABET)])
    return "".join(result)


def ip_to_id(ip: str, port: int, shared_secret: bytes) -> str:
    """
    تحويل IP + Port إلى ID بصيغة 1a2a3a4a5a
    
    مثال:
        >>> secret = b"my_shared_secret_32bytes_long!!"
        >>> ip_to_id("41.100.20.5", 5000, secret)
        '1a2a3a4a5a'
    """
    key = derive_key(shared_secret)
    box = SecretBox(key)
    
    # البيانات: IP + Port
    plaintext = f"{ip}:{port}".encode()
    
    # nonce ثابت مشتق من IP (حتى يكون الـ ID ثابت لنفس IP)
    # ⚠️ ملاحظة أمنية: nonce ثابت آمن هنا لأن المفتاح ثابت والبيانات ثابتة
    #    لكن لا تستخدم هذه الطريقة لتشفير رسائل متعددة!
    nonce_seed = hashlib.sha256(plaintext + shared_secret[:8]).digest()[:24]
    nonce = nonce_seed
    
    # تشفير
    encrypted = box.encrypt(plaintext, nonce).ciphertext
    
    # تحويل لـ ID قصير
    id_hash = hashlib.sha256(encrypted + key).digest()
    short_id = _base32_custom(id_hash, 10)
    
    return short_id


def id_to_ip(short_id: str, shared_secret: bytes) -> str:
    """
    ⚠️ ملاحظة مهمة:
    لا يمكن عكس ID → IP بدون جدول لأن التشفير أحادي الاتجاه.
    
    الحل العملي:
    - صاحبك يعطيك ID + بيانات مساعدة (نوع الاتصال، إلخ)
    - أو نستخدم تشفير ثنائي الاتجاه مع nonce معروف.
    
    سأشرح الحل الأفضل في دالة id_to_ip_secure() أدناه.
    """
    raise NotImplementedError(
        "استخدم id_to_ip_secure() — الـ ID الأحادي لا يمكن عكسه"
    )


# ═══════════════════════════════════════════════════════════
#  4. الحل العملي: ID يحمل IP مشفراً + checksum
# ═══════════════════════════════════════════════════════════

def encode_id(ip: str, port: int, shared_secret: bytes) -> str:
    """
    تشفير IP + Port إلى ID قابل للفك.
    
    الصيغة النهائية: 12 حرف (10 للبيانات + 2 للتحقق)
    
    مثال: '1a2a3a4a5a7b'
    """
    # 1. ادمج IP + Port في 6 بايتات
    octets = [int(x) for x in ip.split(".")]
    if len(octets) != 4:
        raise ValueError("IP غير صحيح")
    
    # IP (4 بايتات) + Port (2 بايتات)
    packed = bytes(octets) + port.to_bytes(2, "big")
    
    # 2. اشتقاق مفتاح التشفير
    key = derive_key(shared_secret)
    
    # 3. تشفير XOR بمفتاح متدفق (بسيط لكن آمن مع SHA-256)
    #    نستخدم تشفير stream: keystream = SHA256(key || counter)
    keystream = b""
    counter = 0
    while len(keystream) < len(packed):
        keystream += hashlib.sha256(key + counter.to_bytes(4, "big")).digest()
        counter += 1
    
    encrypted = bytes(a ^ b for a, b in zip(packed, keystream))
    
    # 4. تحويل 6 بايتات → 10 أحرف Base32
    id_body = _base32_encode_6bytes(encrypted)
    
    # 5. إضافة checksum (2 أحرف)
    checksum = hashlib.sha256(encrypted + key).digest()[:2]
    checksum_str = _base32_custom(checksum, 2)
    
    return id_body + checksum_str


def decode_id(short_id: str, shared_secret: bytes) -> tuple[str, int]:
    """
    فك تشفير ID → (IP, Port)
    
    مثال:
        >>> decode_id("1a2a3a4a5a7b", secret)
        ('41.100.20.5', 5000)
    """
    if len(short_id) != 12:
        raise ValueError("ID يجب أن يكون 12 حرف")
    
    id_body = short_id[:10]
    checksum_str = short_id[10:12]
    
    # 1. تحويل 10 أحرف → 6 بايتات
    encrypted = _base32_decode_10chars(id_body)
    
    # 2. التحقق من checksum
    key = derive_key(shared_secret)
    expected_checksum = hashlib.sha256(encrypted + key).digest()[:2]
    expected_checksum_str = _base32_custom(expected_checksum, 2)
    
    if checksum_str != expected_checksum_str:
        raise ValueError("ID غير صالح (checksum فشل)")
    
    # 3. فك التشفير
    keystream = b""
    counter = 0
    while len(keystream) < 6:
        keystream += hashlib.sha256(key + counter.to_bytes(4, "big")).digest()
        counter += 1
    
    packed = bytes(a ^ b for a, b in zip(encrypted, keystream))
    
    # 4. استخراج IP + Port
    ip = ".".join(str(b) for b in packed[:4])
    port = int.from_bytes(packed[4:6], "big")
    
    return ip, port


# ═══════════════════════════════════════════════════════════
#  5. Base32 مخصص لـ 6 بايتات → 10 أحرف
# ═══════════════════════════════════════════════════════════

def _base32_encode_6bytes(data: bytes) -> str:
    """
    6 بايتات = 48 بت = 10 أحرف Base32 (5 بت لكل حرف = 50 بت)
    نستخدم 48 بت فقط.
    """
    if len(data) != 6:
        raise ValueError("يجب أن يكون 6 بايتات")
    
    value = int.from_bytes(data, "big")
    chars = []
    for i in range(10):
        idx = (value >> (45 - i * 5)) & 0x1F  # 5 بتات
        chars.append(ALPHABET[idx % len(ALPHABET)])
    return "".join(chars)


def _base32_decode_10chars(s: str) -> bytes:
    """عكس _base32_encode_6bytes"""
    if len(s) != 10:
        raise ValueError("يجب أن يكون 10 أحرف")
    
    value = 0
    for c in s:
        idx = ALPHABET.index(c)
        value = (value << 5) | idx
    
    # نحتاج أول 48 بت فقط
    value &= (1 << 48) - 1
    return value.to_bytes(6, "big")


