"""
protocol.py — تعريف بروتوكول P2P
==================================
كل رسالة = Header (16 بايت) + Payload (مشغّر)

Header:
┌──────────┬──────────┬──────────┬──────────┬──────────┐
│  Magic   │  Version │   Type   │  Length  │  SeqNum  │
│  (3)     │  (1)     │  (1)     │  (4)     │  (7)     │
└──────────┴──────────┴──────────┴──────────┴──────────┘
  3 بايت     1 بايت     1 بايت     4 بايتات   7 بايتات
"""

import struct
import os
import asyncio
from enum import IntEnum
from dataclasses import dataclass
from typing import Optional, Tuple
from collections import deque


# ═══════════════════════════════════════════════════════════
#  1. ثوابت البروتوكول
# ═══════════════════════════════════════════════════════════

MAGIC = b"P2P"              # 3 بايت
PROTOCOL_VERSION = 1        # 1 بايت
HEADER_SIZE = 16            # 3 + 1 + 1 + 4 + 7
MAX_PAYLOAD_SIZE = 16 * 1024 * 1024  # 16 MB حد أقصى للرسالة الواحدة

# رقم التسلسل يبدأ من هنا
INITIAL_SEQ = 1


class MessageType(IntEnum):
    """أنواع الرسائل"""
    # الاتصال
    HELLO           = 0x01  # ترحيب أولي
    HANDSHAKE       = 0x02  # تبادل مفاتيح
    HANDSHAKE_ACK   = 0x03  # تأكيد التبادل
    
    # الرسائل
    TEXT            = 0x10  # رسالة نصية
    TYPING          = 0x11  # يكتب الآن...
    READ_RECEIPT    = 0x12  # تم القراءة
    
    # الملفات
    FILE_START      = 0x20  # بداية ملف (اسم + حجم)
    FILE_CHUNK      = 0x21  # جزء من ملف
    FILE_END        = 0x22  # نهاية ملف
    FILE_ACK        = 0x23  # تأكيد استلام جزء
    FILE_CANCEL     = 0x24  # إلغاء الإرسال
    FILE_RESUME     = 0x25  # استئناف إرسال
    
    # التحكم
    PING            = 0x30  # فحص الاتصال
    PONG            = 0x31  # رد الفحص
    ERROR           = 0x32  # خطأ
    CLOSE           = 0x33  # إغلاق الجلسة
    KEY_ROTATE      = 0x34  # تبديل مفاتيح الجلسة
    
    # التعاون (للبرمجة)
    CODE_SYNC       = 0x40  # مزامنة كود
    CURSOR_POS      = 0x41  # موقع المؤشر
    TERMINAL_OUT    = 0x42  # إخراج طرفية


# ═══════════════════════════════════════════════════════════
#  2. بنية الرسالة
# ═══════════════════════════════════════════════════════════

@dataclass
class Message:
    """رسالة واحدة"""
    type: MessageType
    payload: bytes
    seq: int = 0
    
    def __repr__(self):
        return f"<Message type={self.type.name} seq={self.seq} len={len(self.payload)}>"


# ═══════════════════════════════════════════════════════════
#  3. ترميز / فك ترميز الـ Header
# ═══════════════════════════════════════════════════════════

def encode_header(msg_type: MessageType, length: int, seq: int) -> bytes:
    """
    بناء الـ Header (16 بايت).
    
    البنية:
        MAGIC (3) + VERSION (1) + TYPE (1) + LENGTH (4) + SEQ (7)
    """
    if length > MAX_PAYLOAD_SIZE:
        raise ValueError(f"الحمولة كبيرة جداً: {length}")
    
    if not (0 <= seq < 2**56):
        raise ValueError(f"رقم التسلسل خارج المدى: {seq}")
    
    magic = MAGIC
    version = PROTOCOL_VERSION.to_bytes(1, "big")
    msg_type_b = int(msg_type).to_bytes(1, "big")
    length_b = length.to_bytes(4, "big")
    seq_b = seq.to_bytes(7, "big")
    
    header = magic + version + msg_type_b + length_b + seq_b
    assert len(header) == HEADER_SIZE
    return header


def decode_header(header: bytes) -> Tuple[MessageType, int, int]:
    """
    فك الـ Header.
    
    Returns:
        (msg_type, length, seq)
        
    Raises:
        ValueError: إذا كان الـ Header غير صالح
    """
    if len(header) != HEADER_SIZE:
        raise ValueError(f"Header يجب أن يكون {HEADER_SIZE} بايت، وليس {len(header)}")
    
    magic = header[0:3]
    if magic != MAGIC:
        raise ValueError(f"Magic غير صحيح: {magic!r}")
    
    version = header[3]
    if version != PROTOCOL_VERSION:
        raise ValueError(f"إصدار البروتوكول غير مدعوم: {version}")
    
    try:
        msg_type = MessageType(header[4])
    except ValueError:
        raise ValueError(f"نوع رسالة غير معروف: {header[4]:#x}")
    
    length = int.from_bytes(header[5:9], "big")
    seq = int.from_bytes(header[9:16], "big")
    
    if length > MAX_PAYLOAD_SIZE:
        raise ValueError(f"الحمولة كبيرة جداً: {length}")
    
    return msg_type, length, seq


# ═══════════════════════════════════════════════════════════
#  4. بناء / تفكيك الرسائل الكاملة
# ═══════════════════════════════════════════════════════════

class MessageBuilder:
    """يبني الرسائل بأرقام تسلسل متزايدة"""
    
    def __init__(self, start_seq: int = INITIAL_SEQ):
        self._seq = start_seq
    
    def build(self, msg_type: MessageType, payload: bytes = b"") -> bytes:
        """بناء رسالة كاملة (Header + Payload)"""
        header = encode_header(msg_type, len(payload), self._seq)
        self._seq += 1
        return header + payload
    
    @property
    def next_seq(self) -> int:
        return self._seq
    
    def reset(self, seq: int = INITIAL_SEQ):
        self._seq = seq


# ═══════════════════════════════════════════════════════════
#  5. قارئ الرسائل (MessageReader)
# ═══════════════════════════════════════════════════════════

class MessageReader:
    """
    يقرأ رسائل من stream بطريقة موثوقة.
    
    المشكلة: TCP stream لا يحافظ على حدود الرسائل.
    الحل: نقرأ 16 بايت header، ثم نعرف الطول، ثم نقرأ الحمولة كاملة.
    """
    
    def __init__(self, reader: asyncio.StreamReader):
        self._reader = reader
        self._expected_seq = INITIAL_SEQ
        self._reorder_buffer: dict[int, Message] = {}
        self._max_buffer = 100  # حد أقصى للرسائل خارج الترتيب
    
    async def read_message(self) -> Message:
        """
        قراءة رسالة واحدة.
        
        Raises:
            asyncio.IncompleteReadError: إذا انقطع الاتصال
            ValueError: إذا كانت الرسالة غير صالحة
        """
        # 1. قراءة الـ Header
        header = await self._reader.readexactly(HEADER_SIZE)
        msg_type, length, seq = decode_header(header)
        
        # 2. قراءة الحمولة
        payload = b""
        if length > 0:
            payload = await self._reader.readexactly(length)
        
        return Message(type=msg_type, payload=payload, seq=seq)
    
    async def read_ordered(self) -> Message:
        """
        قراءة مع ضمان الترتيب.
        إذا وصلت رسالة خارج الترتيب، نخزّنها وننتظر ما قبلها.
        """
        while True:
            msg = await self.read_message()
            
            if msg.seq == self._expected_seq:
                # الرسالة المتوقعة
                self._expected_seq += 1
                self._flush_reorder_buffer()
                return msg
            
            elif msg.seq < self._expected_seq:
                # رسالة قديمة (مكررة) — نتجاهلها
                continue
            
            else:
                # رسالة مستقبلية — نخزّنها وننتظر
                if msg.seq in self._reorder_buffer:
                    continue  # مكررة
                
                self._reorder_buffer[msg.seq] = msg
                
                if len(self._reorder_buffer) > self._max_buffer:
                    raise ValueError("العديد من الرسائل خارج الترتيب — خلل محتمل")
                
                # استمر في القراءة
                continue
    
    def _flush_reorder_buffer(self):
        """إخراج الرسائل من المخزن بالترتيب"""
        # (تُستخدم عند الحاجة في النسخة المتقدمة)
        pass


# ═══════════════════════════════════════════════════════════
#  6. كاتب الرسائل (MessageWriter)
# ═══════════════════════════════════════════════════════════

class MessageWriter:
    """يكتب رسائل إلى stream"""
    
    def __init__(self, writer: asyncio.StreamWriter):
        self._writer = writer
        self._builder = MessageBuilder()
        self._lock = asyncio.Lock()
        self._bytes_sent = 0
        self._messages_sent = 0
    
    async def send(self, msg_type: MessageType, payload: bytes = b""):
        """إرسال رسالة"""
        async with self._lock:
            data = self._builder.build(msg_type, payload)
            self._writer.write(data)
            await self._writer.drain()
            self._bytes_sent += len(data)
            self._messages_sent += 1
    
    async def send_text(self, text: str):
        """إرسال رسالة نصية"""
        await self.send(MessageType.TEXT, text.encode("utf-8"))
    
    @property
    def stats(self):
        return {
            "bytes_sent": self._bytes_sent,
            "messages_sent": self._messages_sent,
        }


# ═══════════════════════════════════════════════════════════
#  7. أنواع الحمولات (Payloads)
# ═══════════════════════════════════════════════════════════

# ----- TEXT -----
# ببساطة: UTF-8 bytes

# ----- TYPING -----
# ببساطة: 1 بايت (1 = يكتب، 0 = توقف)

# ----- READ_RECEIPT -----
# 7 بايت: seq للرسالة التي قُرئت

# ----- FILE_START -----
# البنية:
#   name_len (2) + name (UTF-8) + total_size (8) + sha256 (32) + chunks (4)
FILE_START_FORMAT = ">H"  # name_len

def encode_file_start(filename: str, total_size: int,
                     file_sha256: bytes, total_chunks: int) -> bytes:
    name_bytes = filename.encode("utf-8")
    if len(name_bytes) > 65535:
        raise ValueError("اسم الملف طويل جداً")
    
    return (
        struct.pack(">H", len(name_bytes)) +
        name_bytes +
        struct.pack(">Q", total_size) +
        file_sha256 +
        struct.pack(">I", total_chunks)
    )


def decode_file_start(payload: bytes) -> dict:
    offset = 0
    name_len = struct.unpack(">H", payload[offset:offset+2])[0]
    offset += 2
    
    filename = payload[offset:offset+name_len].decode("utf-8")
    offset += name_len
    
    total_size = struct.unpack(">Q", payload[offset:offset+8])[0]
    offset += 8
    
    file_sha256 = payload[offset:offset+32]
    offset += 32
    
    total_chunks = struct.unpack(">I", payload[offset:offset+4])[0]
    offset += 4
    
    return {
        "filename": filename,
        "total_size": total_size,
        "sha256": file_sha256,
        "total_chunks": total_chunks,
    }


# ----- FILE_CHUNK -----
# البنية:
#   file_id (4) + chunk_index (4) + data
def encode_file_chunk(file_id: int, chunk_index: int, data: bytes) -> bytes:
    return struct.pack(">II", file_id, chunk_index) + data


def decode_file_chunk(payload: bytes) -> dict:
    file_id, chunk_index = struct.unpack(">II", payload[:8])
    return {
        "file_id": file_id,
        "chunk_index": chunk_index,
        "data": payload[8:],
    }


# ----- FILE_END -----
# البنية: file_id (4) + sha256 (32)
def encode_file_end(file_id: int, file_sha256: bytes) -> bytes:
    return struct.pack(">I", file_id) + file_sha256


def decode_file_end(payload: bytes) -> dict:
    file_id = struct.unpack(">I", payload[:4])[0]
    return {
        "file_id": file_id,
        "sha256": payload[4:36],
    }


# ----- FILE_ACK -----
# البنية: file_id (4) + chunk_index (4) + status (1)
def encode_file_ack(file_id: int, chunk_index: int, status: int = 0) -> bytes:
    return struct.pack(">IIB", file_id, chunk_index, status)


def decode_file_ack(payload: bytes) -> dict:
    file_id, chunk_index, status = struct.unpack(">IIB", payload[:9])
    return {
        "file_id": file_id,
        "chunk_index": chunk_index,
        "status": status,  # 0=OK, 1=خطأ, 2=إلغاء
    }


# ----- ERROR -----
# البنية: code (2) + message (UTF-8)
def encode_error(code: int, message: str) -> bytes:
    msg_bytes = message.encode("utf-8")
    return struct.pack(">H", code) + msg_bytes


def decode_error(payload: bytes) -> dict:
    code = struct.unpack(">H", payload[:2])[0]
    return {
        "code": code,
        "message": payload[2:].decode("utf-8", errors="replace"),
    }


# ----- CLOSE -----
# البنية: reason (1) + message (UTF-8)
def encode_close(reason: int, message: str = "") -> bytes:
    return struct.pack(">B", reason) + message.encode("utf-8")


def decode_close(payload: bytes) -> dict:
    reason = payload[0] if payload else 0
    return {
        "reason": reason,
        "message": payload[1:].decode("utf-8", errors="replace") if len(payload) > 1 else "",
    }


# ----- PING / PONG -----
# البنية: timestamp (8) + random (8)
def encode_ping() -> bytes:
    import time
    return struct.pack(">QQ", int(time.time() * 1000), int.from_bytes(os.urandom(8), "big"))


def decode_ping(payload: bytes) -> dict:
    timestamp, nonce = struct.unpack(">QQ", payload[:16])
    return {"timestamp": timestamp, "nonce": nonce}


# ═══════════════════════════════════════════════════════════
#  8. نبضات الاتصال (Heartbeat)
# ═══════════════════════════════════════════════════════════

class Heartbeat:
    """
    يرسل PING دورياً للتحقق من الاتصال.
    إذا لم يصل PONG خلال timeout، يُعلن انقطاع الاتصال.
    """
    
    def __init__(self, writer: MessageWriter,
                 interval: float = 15.0,
                 timeout: float = 30.0):
        self._writer = writer
        self._interval = interval
        self._timeout = timeout
        self._last_pong = 0.0
        self._task: Optional[asyncio.Task] = None
        self._on_dead = None
        self._running = False
    
    def on_dead(self, callback):
        """تعيين callback عند انقطاع الاتصال"""
        self._on_dead = callback
    
    async def start(self):
        """بدء النبضات"""
        if self._running:
            return
        self._running = True
        self._last_pong = asyncio.get_event_loop().time()
        self._task = asyncio.create_task(self._loop())
    
    async def stop(self):
        """إيقاف النبضات"""
        self._running = False
        if self._task:
            self._task.cancel()
            try:
                await self._task
            except asyncio.CancelledError:
                pass
    
    def received_pong(self):
        """يُستدعى عند وصول PONG"""
        self._last_pong = asyncio.get_event_loop().time()
    
    async def _loop(self):
        try:
            while self._running:
                await asyncio.sleep(self._interval)
                
                # إرسال PING
                try:
                    await self._writer.send(MessageType.PING, encode_ping())
                except Exception:
                    break
                
                # فحص الوقت منذ آخر PONG
                elapsed = asyncio.get_event_loop().time() - self._last_pong
                if elapsed > self._timeout:
                    if self._on_dead:
                        self._on_dead()
                    break
        except asyncio.CancelledError:
            pass
