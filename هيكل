"""
crypto.py — تشفير AES-256-GCM للرسائل والملفات
==================================================
- تشفير مصادَق عليه (Authenticated Encryption)
- كل رسالة لها nonce خاص
- كشف أي تلاعب في البيانات
- دعم إرسال ملفات كبيرة (chunks)
"""

import os
import hashlib
import hmac
import struct
from nacl.secret import SecretBox
from nacl.utils import random as nacl_random
from nacl.exceptions import CryptoError


# ═══════════════════════════════════════════════════════════
#  1. اشتقاق مفاتيح الجلسة
# ═══════════════════════════════════════════════════════════

def derive_session_key(shared_secret: bytes, salt: bytes = b"") -> bytes:
    """
    اشتقاق مفتاح جلسة 32 بايت من السر المشترك.
    HKDF-like: SHA256(salt || secret || info)
    """
    if len(shared_secret) < 16:
        raise ValueError("السر المشترك قصير جداً")
    
    info = b"p2p-session-key-v1"
    prk = hmac.new(salt or b"p2p-salt-v1", shared_secret, hashlib.sha256).digest()
    okm = hmac.new(prk, info, hashlib.sha256).digest()
    return okm


def generate_session_salt() -> bytes:
    """توليد salt عشوائي لكل جلسة"""
    return os.urandom(16)


# ═══════════════════════════════════════════════════════════
#  2. التشفير / فك التشفير
# ═══════════════════════════════════════════════════════════

class SecureChannel:
    """
    قناة آمنة للتشفير/فك التشفير.
    كل جلسة لها SecureChannel خاص.
    """
    
    def __init__(self, session_key: bytes, my_nonce_prefix: bytes = b""):
        """
        session_key: 32 بايت
        my_nonce_prefix: 4 بايت لتمييز رسائلي عن رسائل الطرف الآخر
        """
        if len(session_key) != 32:
            raise ValueError("مفتاح الجلسة يجب أن يكون 32 بايت")
        
        self._box = SecretBox(session_key)
        self._send_counter = 0
        self._recv_counter = 0
        self._nonce_prefix = my_nonce_prefix or os.urandom(4)
    
    def encrypt(self, plaintext: bytes, aad: bytes = b"") -> bytes:
        """
        تشفير رسالة.
        
        Returns:
            nonce (24 بايت) + ciphertext (مشفّر + tag)
        """
        # nonce = prefix (4) + counter (8) + random (12) = 24 بايت
        # ⚠️ غير آمن لإعادة الاستخدام! لكن مع counter متزايد، مضمون.
        counter_bytes = self._send_counter.to_bytes(8, "big")
        random_part = os.urandom(12)
        nonce = self._nonce_prefix + counter_bytes + random_part
        
        self._send_counter += 1
        
        # تشفير
        encrypted = self._box.encrypt(plaintext, nonce).ciphertext
        return nonce + encrypted
    
    def decrypt(self, data: bytes) -> bytes:
        """
        فك تشفير رسالة.
        
        Args:
            data: nonce (24) + ciphertext (المشفّر)
        """
        if len(data) < 24 + 16:  # nonce + MAC tag
            raise ValueError("البيانات قصيرة جداً")
        
        nonce = data[:24]
        ciphertext = data[24:]
        
        try:
            plaintext = self._box.decrypt(ciphertext, nonce)
        except CryptoError as e:
            raise ValueError(f"فشل فك التشفير (تلاعب محتمل): {e}")
        
        self._recv_counter += 1
        return plaintext
    
    def encrypt_text(self, text: str, aad: bytes = b"") -> bytes:
        return self.encrypt(text.encode("utf-8"), aad)
    
    def decrypt_text(self, data: bytes) -> str:
        return self.decrypt(data).decode("utf-8")


# ═══════════════════════════════════════════════════════════
#  3. التحقق من السلامة (SHA-256)
# ═══════════════════════════════════════════════════════════

def sha256(data: bytes) -> bytes:
    """حساب SHA-256"""
    return hashlib.sha256(data).digest()


def verify_sha256(data: bytes, expected: bytes) -> bool:
    """التحقق من SHA-256"""
    return hmac.compare_digest(sha256(data), expected)


# ═══════════════════════════════════════════════════════════
#  4. تشفير الملفات (Chunks)
# ═══════════════════════════════════════════════════════════

CHUNK_SIZE = 64 * 1024  # 64 KB


class FileEncryptor:
    """
    تشفير ملفات كبيرة chunk-by-chunk.
    لا تحمّل الملف كامل في الذاكرة.
    """
    
    def __init__(self, channel: SecureChannel):
        self._channel = channel
    
    def encrypt_file(self, filepath: str, output_path: str = None):
        """
        تشفير ملف كامل.
        
        البنية:
            [حجم الملف الأصلي: 8 بايت]
            [اسم الملف: 2 بايت طول + بيانات]
            [SHA-256 للملف الأصلي: 32 بايت]
            [chunks مشفّرة...]
        """
        import aiofiles
        raise NotImplementedError("استخدم النسخة async")
    
    async def encrypt_file_async(self, filepath: str) -> bytes:
        """
        يقرأ ملفاً ويشفره كاملاً في الذاكرة.
        ⚠️ للاستخدام فقط مع الملفات الصغيرة (<100MB).
        للملفات الكبيرة: استخدم encrypt_file_stream_async
        """
        import aiofiles
        
        async with aiofiles.open(filepath, "rb") as f:
            data = await f.read()
        
        checksum = sha256(data)
        filename = os.path.basename(filepath).encode("utf-8")
        
        # header
        header = struct.pack(">I", len(filename)) + filename
        header += struct.pack(">Q", len(data))
        header += checksum
        
        # دمج + تشفير
        payload = header + data
        return self._channel.encrypt(payload)
    
    async def encrypt_file_stream_async(self, filepath: str):
        """
        مولد (generator) يقرأ الملف chunk chunk ويشفّر كل chunk.
        
        Yields:
            (chunk_index, total_chunks, encrypted_chunk)
        """
        import aiofiles
        
        filesize = os.path.getsize(filepath)
        total_chunks = (filesize + CHUNK_SIZE - 1) // CHUNK_SIZE
        
        async with aiofiles.open(filepath, "rb") as f:
            index = 0
            while True:
                chunk = await f.read(CHUNK_SIZE)
                if not chunk:
                    break
                
                # تشفير chunk
                encrypted = self._channel.encrypt(chunk)
                yield (index, total_chunks, encrypted)
                index += 1


class FileDecryptor:
    """فك تشفير الملفات"""
    
    def __init__(self, channel: SecureChannel):
        self._channel = channel
    
    def decrypt_chunk(self, encrypted_chunk: bytes) -> bytes:
        """فك تشفير chunk واحد"""
        return self._channel.decrypt(encrypted_chunk)
    
    def decrypt_file(self, encrypted_data: bytes) -> tuple[str, bytes]:
        """
        فك تشفير ملف كامل.
        
        Returns:
            (filename, file_data)
        """
        payload = self._channel.decrypt(encrypted_data)
        
        # قراءة header
        offset = 0
        
        # اسم الملف
        name_len = struct.unpack(">I", payload[offset:offset+4])[0]
        offset += 4
        filename = payload[offset:offset+name_len].decode("utf-8")
        offset += name_len
        
        # حجم الملف
        filesize = struct.unpack(">Q", payload[offset:offset+8])[0]
        offset += 8
        
        # checksum
        expected_checksum = payload[offset:offset+32]
        offset += 32
        
        # البيانات
        file_data = payload[offset:]
        
        # التحقق
        if len(file_data) != filesize:
            raise ValueError(f"حجم الملف غير مطابق: {len(file_data)} != {filesize}")
        if not verify_sha256(file_data, expected_checksum):
            raise ValueError("SHA-256 غير مطابق — الملف تالف أو متلاعب به")
        
        return filename, file_data


# ═══════════════════════════════════════════════════════════
#  5. مسح آمن للذاكرة
# ═══════════════════════════════════════════════════════════

def secure_wipe(*buffers):
    """
    مسح آمن من الذاكرة.
    ملاحظة: في Python، لا يمكن ضمان المسح 100% بسبب إدارة الذاكرة،
    لكن هذا أفضل ما يمكن فعله.
    """
    import ctypes
    
    for buf in buffers:
        if isinstance(buf, bytearray):
            # امسح فعلياً
            for i in range(len(buf)):
                buf[i] = 0
        elif isinstance(buf, bytes):
            # bytes غير قابلة للتعديل — نتجاهلها (سيتم جمعها كـ garbage)
            pass
        elif hasattr(buf, "__dict__"):
            # كائن
            for key in list(buf.__dict__.keys()):
                try:
                    val = getattr(buf, key)
                    if isinstance(val, bytearray):
                        secure_wipe(val)
                    setattr(buf, key, None)
                except Exception:
                    pass


