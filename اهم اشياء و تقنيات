async def send_file(stream, box, filepath, chunk_size=64*1024):
    """إرسال ملف كبير بدون تحميله كامل في الذاكرة"""
    import os
    
    filesize = os.path.getsize(filepath)
    filename = os.path.basename(filepath)
    
    # 1. إرسال معلومات الملف
    await send_message(stream, box, 0x03, 
                       f"{filename}|{filesize}")
    
    # 2. إرسال chunks
    sent = 0
    with open(filepath, 'rb') as f:
        while True:
            chunk = f.read(chunk_size)
            if not chunk:
                break
            
            # تشفير كل chunk
            nonce = random(SecretBox.NONCE_SIZE)
            encrypted = box.encrypt(chunk, nonce).ciphertext
            
            # إرسال
            header = struct.pack(">4sBI7s", b"P2P1", 0x04,
                                 len(encrypted), nonce[:7])
            stream.write(header + encrypted)
            await stream.drain()
            
            sent += len(chunk)
            print(f"\rProgress: {sent/filesize*100:.1f}%", end='')
    
    # 3. إرسال نهاية
    await send_message(stream, box, 0x05, "EOF")
