Import hashlib
import base64
from nacl.secret import SecretBox
from nacl.utils import random

def derive_id_key(shared_secret: bytes) -> bytes:
    """اشتقاق مفتاح التشفير من السر المشترك"""
    return hashlib.sha256(shared_secret + b"p2p_id_v1").digest()

def ip_to_id(ip_address: str, shared_secret: bytes, port: int = 5000) -> str:
    """
    تحويل IP + Port إلى ID مشفر
    مثال: 41.100.20.5 → 1a2a3a4a5a
    """
    # تجهيز البيانات
    data = f"{ip_address}:{port}".encode()
    
    # اشتقاق المفتاح
    key = derive_id_key(shared_secret)
    box = SecretBox(key)
    
    # تشفير
    nonce = random(SecretBox.NONCE_SIZE)
    encrypted = box.encrypt(data, nonce).ciphertext
    
    # تحويل لـ Base32 وأخذ أول 10 أحرف
    encoded = base64.b32encode(encrypted).decode().lower()
    return encoded[:10]

def id_to_ip(encoded_id: str, shared_secret: bytes) -> str:
    """
    فك تشفير ID لاستخراج IP
    ملاحظة: نحتاج تخزين nonce أو استخدام nonce ثابت
    """
    # في التطبيق الحقيقي: nonce يُرسل مع ID أو يُشتق
    # هذا مبسط للتوضيح
    key = derive_id_key(shared_secret)
