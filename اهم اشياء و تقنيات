def generate_short_id(ip: str, secret: bytes) -> str:
    """توليد ID بصيغة 1a2a3a4a5a"""
    # تشفير IP
    key = derive_id_key(secret)
    box = SecretBox(key)
    nonce = random(SecretBox.NONCE_SIZE)
    encrypted = box.encrypt(f"{ip}:5000".encode(), nonce).ciphertext
    
    # Base32 → أحرف صغيرة + أرقام
    b32 = base64.b32encode(encrypted + nonce).decode().lower()
    
    # استبدال الأحرف لتشبه النمط المطلوب
    result = ""
    for i, c in enumerate(b32[:10]):
        if i % 2 == 0:
            # موقع زوجي: حرف
            result += chr(ord('a') + (ord(c) % 26))
        else:
            # موقع فردي: رقم
            result += str((ord(c) % 10))
    
    return result
