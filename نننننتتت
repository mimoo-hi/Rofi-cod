{
  "layer": "top",
  "position": "top",
  "height": 36,
  
  "modules-left": ["sway/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["cpu", "memory", "disk", "temperature", "backlight", "battery", "network", "pulseaudio", "tray"],
  
  "clock": {
    "format": "{:%I:%M %p}",
    "interval": 60
  },
  
  "battery": {
    "format": "{capacity}%",
    "interval": 30
  },
  
  "cpu": {
    "format": "{usage}%",
    "interval": 2
  },
  
  "memory": {
    "format": "{percentage}%",
    "interval": 5
  },
  
  "disk": {
    "format": "{percentage_used}%",
    "path": "/"
  },
  
  "temperature": {
    "format": "{temperature}°C",
    "interval": 10
  },
  
  "backlight": {
    "format": "{percent}%",
    "device": "intel_backlight"
  },
  
  "network": {
    "format-wifi": "{signalStrength}%",
    "format-ethernet": "100%",
    "interval": 5
  },
  
  "pulseaudio": {
    "format": "{volume}%",
    "scroll-step": 5
  },
  
  "tray": {
    "icon-size": 16,
    "spacing": 8
  }
}
